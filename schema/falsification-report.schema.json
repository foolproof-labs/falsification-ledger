{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metabolism-tools/falsification-ledger/schema/falsification-report.schema.json",
  "title": "FalsificationReport v1",
  "note": "Independent statistical falsification report for a research candidate. Produced by a program isolated from the research and evaluation sides. Required evidence for falsification review and promotion gates. Contract v1: null-model construction is standardized; different implementations must agree within the declared p-value tolerance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_artifact_id",
    "candidate_type",
    "falsification_type",
    "null_model",
    "metrics",
    "conclusion",
    "program",
    "data_window",
    "generated_at",
    "safety_contract"
  ],
  "properties": {
    "schema_version": {"const": "falsification_ledger.falsification_report.v1"},
    "candidate_artifact_id": {"$ref": "#/$defs/content_id"},
    "preregistration_id": {"type": "string", "minLength": 1},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifest_sha256", "cutoff"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cutoff": {"type": "string", "minLength": 1},
        "files": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_type": {
      "enum": ["factor", "strategy", "experiment", "data_endpoint", "mechanism", "evaluation_meta"]
    },
    "falsification_type": {
      "enum": [
        "null_model_randomization",
        "oos_rank_ic",
        "fdr_correction",
        "protocol_deviation",
        "effect_ci",
        "cost_sensitivity",
        "state_transition_stability",
        "other"
      ]
    },
    "null_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construction", "n_permutations", "distribution", "random_seed", "seed_fixed"],
      "properties": {
        "construction": {"type": "string", "minLength": 1},
        "n_permutations": {"type": "integer", "minimum": 1},
        "distribution": {"type": "string", "minLength": 1},
        "random_seed": {"type": "integer"},
        "seed_fixed": {"const": true}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "conclusion": {
      "enum": ["not_falsified", "falsified", "inconclusive"]
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compared_report_id", "max_p_value_diff", "tolerance", "consistent"],
      "properties": {
        "compared_report_id": {"$ref": "#/$defs/content_id"},
        "max_p_value_diff": {"type": "number", "minimum": 0},
        "tolerance": {"const": 0.005},
        "consistent": {"type": "boolean"}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "data_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "generated_at": {"type": "string", "minLength": 1},
    "safety_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_effect", "changes_probability", "allow_real_trade"],
      "properties": {
        "production_effect": {"const": false},
        "changes_probability": {"const": false},
        "allow_real_trade": {"const": false},
        "stage": {"type": "string"},
        "channel": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "note": {"type": "string"}
  },
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "p_value", "null_distribution"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "p_value": {"type": "number", "minimum": 0, "maximum": 1},
        "note": {"type": "string"},
        "null_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n_permutations", "seed", "reproducible"],
          "properties": {
            "n_permutations": {"type": "integer", "minimum": 1},
            "seed": {"type": "integer"},
            "reproducible": {"const": true}
          }
        }
      }
    }
  }
}
